{
  "name": "Opportunity Scout: weekly email",
  "nodes": [
    {
      "name": "Every Monday 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * 1" }] } }
    },
    {
      "name": "Run weekly scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [224, 0],
      "parameters": {
        "method": "POST",
        "url": "https://opportunity-scout-98lk.onrender.com/api/digest/weekly",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"profile\": {\n    \"name\": \"Ekang Agritech\",\n    \"one_liner\": \"Smartphone crop-disease diagnosis for smallholder farmers in Cameroon\",\n    \"stage\": \"pre-seed\",\n    \"sectors\": [\"agritech\", \"AI\", \"climate\"],\n    \"country\": \"Cameroon\",\n    \"regions_served\": [\"Cameroon\", \"Central Africa\"],\n    \"goals\": [\"Non-dilutive funding to extend the pilot\", \"Cloud and AI API credits\"],\n    \"exclude_keywords\": [\"crypto\", \"token sale\"]\n  },\n  \"queries\": [\n    \"agritech grants Africa 2027 applications open\",\n    \"pre-seed accelerator Africa AI startups 2027\",\n    \"startup competition Cameroon 2027\"\n  ],\n  \"min_score\": 60,\n  \"results_per_query\": 4,\n  \"deadline_window_days\": 45,\n  \"app_url\": \"https://opportunity-scout-98lk.onrender.com\"\n}",
        "options": { "timeout": 600000 }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "name": "Anything to report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [448, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.new_count + $json.upcoming_count }}",
              "operator": { "type": "number", "operation": "gt" },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Send weekly email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [672, 0],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": { "appendAttribution": false, "senderName": "Opportunity Scout" }
      }
    }
  ],
  "connections": {
    "Every Monday 07:00": { "main": [[{ "node": "Run weekly scan", "type": "main", "index": 0 }]] },
    "Run weekly scan": { "main": [[{ "node": "Anything to report?", "type": "main", "index": 0 }]] },
    "Anything to report?": { "main": [[{ "node": "Send weekly email", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
