# LLM: set one provider's key. LLM_PROVIDER picks explicitly when both are set.
LLM_PROVIDER=            # anthropic | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SCOUT_MODEL=             # optional override, e.g. claude-haiku-5-5 or gemini-2.5-pro
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Optional, for publishing to a Notion database that has a "Name" title property
NOTION_TOKEN=
NOTION_DATABASE_ID=
